# Copy to deploy/.env and replace each placeholder. Never commit deploy/.env.
DEVICE_TOKENS={"device-001":"replace-with-device-token"}
LINX_WS_URL=wss://xrobo-io.qiniuapi.com/v1/ws/
LINX_DEVICE_TOKENS={"device-001":"replace-with-linx-device-token"}
MCP_API_TOKEN=replace-with-long-random-secret

# 唤醒词为“灵矽灵矽”；关键词文件须按所选模型的 tokens 词表编码。
# sherpa-onnx 中文模型路径；先运行 bash deploy/prepare-kws.sh 下载权重并生成关键词文件。
KWS_ENCODER=/opt/kws/sherpa-onnx-kws-zipformer-wenetspeech-3.3M-2024-01-01/encoder-epoch-12-avg-2-chunk-16-left-64.int8.onnx
KWS_DECODER=/opt/kws/sherpa-onnx-kws-zipformer-wenetspeech-3.3M-2024-01-01/decoder-epoch-12-avg-2-chunk-16-left-64.int8.onnx
KWS_JOINER=/opt/kws/sherpa-onnx-kws-zipformer-wenetspeech-3.3M-2024-01-01/joiner-epoch-12-avg-2-chunk-16-left-64.int8.onnx
KWS_TOKENS=/opt/kws/sherpa-onnx-kws-zipformer-wenetspeech-3.3M-2024-01-01/tokens.txt
KWS_KEYWORDS_FILE=/opt/kws/sherpa-onnx-kws-zipformer-wenetspeech-3.3M-2024-01-01/keywords.txt
KWS_NUM_THREADS=1

# Optional Janus secrets; configure matching values in the Janus plugin if enabled.
JANUS_API_SECRET=
JANUS_ADMIN_KEY=

# Optional published ports. Janus media UDP range must match the Janus config.
INTERCOM_HTTP_PORT=8080
JANUS_HTTP_PORT=8088
JANUS_WS_PORT=8188
