# Copy to deploy/.env and replace each placeholder. Never commit deploy/.env.
DEVICE_TOKENS={"device-001":"replace-with-device-token"}
LINX_WS_URL=wss://xrobo-io.qiniuapi.com/v1/ws/
LINX_DEVICE_TOKENS={"device-001":"replace-with-linx-device-token"}
MCP_API_TOKEN=replace-with-long-random-secret

# sherpa-onnx streaming keyword model and its keyword list; mount or provision these files.
KWS_ENCODER=
KWS_DECODER=
KWS_JOINER=
KWS_TOKENS=
KWS_KEYWORDS_FILE=
KWS_NUM_THREADS=1

# Optional Janus secrets; configure matching values in the Janus plugin if enabled.
JANUS_API_SECRET=
JANUS_ADMIN_KEY=

# Optional published ports. Janus media UDP range must match the Janus config.
INTERCOM_HTTP_PORT=8080
JANUS_HTTP_PORT=8088
JANUS_WS_PORT=8188
